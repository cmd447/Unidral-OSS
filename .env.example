# --- Core Engine ---
BASE_DOMAIN=example.com
EXTRA_BASE_DOMAINS=
RESERVED_SUBDOMAINS=dashboard,www,api

# --- Firebase / Firestore ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use emulator for development:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Firestore collections (optional — defaults shown)
FIRESTORE_SITE_INDEX_COLLECTION=site_index
FIRESTORE_SETTINGS_COLLECTION=settings
FIRESTORE_SETTINGS_DOC=config
FIRESTORE_DOMAINS_COLLECTION=domains
FIRESTORE_DOMAIN_LOGS_COLLECTION=domain_logs

# --- Domain Management (Cloudflare) ---
CF_API_TOKEN=
CF_ACCOUNT_ID=
VPS_IP=
VPS_IPV6=

# --- SSL Certificates ---
# Path to cloudflare.ini for certbot DNS challenge
CLOUDFLARE_CREDENTIALS=

# --- Proxy Settings ---
ALLOW_PRIVATE_TARGETS=
MAX_HTML_BYTES=

# --- Domain Propagation ---
PROPAGATION_TIMEOUT_MS=600000
PROPAGATION_INTERVAL_MS=30000

# --- Dashboard ---
NEXT_PUBLIC_API_BASE=http://localhost:4000/__unidral/api
DASHBOARD_SUBDOMAIN=dashboard
API_SUBDOMAIN=api
